# Copy to .env and fill in. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any Groq model with tool calling (openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b
# Optional: low | medium | high (gpt-oss models only)
GROQ_REASONING_EFFORT=medium
# Optional: your email or a URL, sent in the User-Agent to Wikipedia/Wikidata when fetching photos,
# flags and club data. Wikimedia allows 200 requests/min with contact info vs 10/min without,
# so photos load ~20x faster when this is set. Leave empty to send no contact details.
WIKIMEDIA_CONTACT=
